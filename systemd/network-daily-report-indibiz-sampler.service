[Unit]
Description=Network Daily Report - Indibiz RouterOS sampler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/mriazh/Github-PC/Network-Daily-Report
EnvironmentFile=/home/mriazh/Github-PC/Network-Daily-Report/config/.env
ExecStart=/home/mriazh/Github-PC/Network-Daily-Report/.venv/bin/python -m network_report.cli sample-indibiz
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
