# ===========================================================================
# Network Daily Report Automation - Environment Configuration (.env)
# ===========================================================================
# Instructions:
# 1. Copy this file to `config/.env` on your target machine.
# 2. Fill in all real credentials, URLs, and paths.
# 3. `config/.env` is git-ignored and MUST NEVER be committed to Git.
# ===========================================================================

# ---------------------------------------------------------------------------
# [1] GENERAL & APPLICATION SETTINGS
# ---------------------------------------------------------------------------
TIMEZONE=Asia/Jakarta
LOG_LEVEL=INFO
DAILY_SCHEDULE_TIME=23:00

# File Paths (Relative to project root or absolute paths)
TEMPLATE_EXCEL=config/Template-Daily-Report.xlsx
TEMPLATE_WAG=config/Template-Daily-WAG.md
ICCID_LOCATION_FILE=config/ICCID-Location.xlsx
CIRCUITS_FILE=config/circuits.json
OUTPUT_ROOT=output
OUTPUT_RAW_ROOT=output/raw

# ---------------------------------------------------------------------------
# [2] WHATSAPP GATEWAY (GOWA)
# ---------------------------------------------------------------------------
# GOWA runs locally on Debian (default port 3000) or via custom host
GOWA_ENABLED=true
GOWA_BASE_URL=http://localhost:3000
GOWA_DEVICE_ID=CHANGE_ME_DEVICE_ID
GOWA_GROUP_JID=CHANGE_ME_TARGET_GROUP@g.us
GOWA_TIMEOUT_SECONDS=20
GOWA_TLS_VERIFY=true

# ---------------------------------------------------------------------------
# [3] NETWORK CONNECTIVITY: CHECK POINT VPN & CLOUDFLARE WARP
# ---------------------------------------------------------------------------
# Required when scrapers need to establish VPN/SOCKS5 proxy before portal access

# Check Point Endpoint Security (trac CLI)
CHECKPOINT_ENABLED=false
# On Linux Debian: trac / /usr/bin/trac
# On Windows Dell: C:/Program Files (x86)/CheckPoint/Endpoint Connect/trac.exe
CHECKPOINT_TRAC_PATH=trac
CHECKPOINT_SITE=CORP-VPN-SITE
CHECKPOINT_GATEWAY=CORP-VPN-GATEWAY
CHECKPOINT_USERNAME=CHANGE_ME_VPN_USER
CHECKPOINT_PASSWORD=CHANGE_ME_VPN_PASS
CHECKPOINT_CONNECT_TIMEOUT_SECONDS=60

# Cloudflare WARP CLI (Isolated SOCKS5 Proxy)
WARP_ENABLED=false
# On Linux Debian: /usr/bin/warp-cli or warp-cli
# On Windows Dell: C:/Program Files/Cloudflare/Cloudflare WARP/warp-cli.exe
WARP_CLI_PATH=warp-cli
WARP_MODE=proxy
WARP_PROXY_PORT=40000
WARP_AUTO_CONNECT=true
WARP_TRACE_URL=https://www.cloudflare.com/cdn-cgi/trace

# ---------------------------------------------------------------------------
# [4] SOURCE 1: TELKOMSEL IOT M2M (CMP PORTAL)
# ---------------------------------------------------------------------------
CMP_ENABLED=true
CMP_BASE_URL=https://cmp-portal.example.internal/cas/login
CMP_USERNAME=CHANGE_ME_CMP_USER
CMP_PASSWORD=CHANGE_ME_CMP_PASS
CMP_HEADLESS=true
CMP_TIMEOUT_SECONDS=60

# 2FA OTP Email Retrieval via IMAP (Required for Telkomsel CMP 2FA)
CMP_IMAP_HOST=mail.example.internal
CMP_IMAP_PORT=993
CMP_EMAIL=alert-receiver@example.internal
CMP_EMAIL_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
OTP_TIMEOUT_SECONDS=120
OTP_POLL_INTERVAL_SECONDS=5

# Pre-downloaded raw directory (from CMP automation tool):
# Example Debian: /path/to/CMP-Automation/output/raw
# Example Windows: C:/path/to/CMP-Automation/output/raw
CMP_RAW_DIR=output/raw/iot

# Dashboard screenshot OCR chain: sidecar .txt -> PaddleOCR -> Gemini Vision.
# PaddleOCR is primary; leave PADDLEOCR_PYTHON empty to auto-discover sibling repo venvs.
# Example Windows: C:/Users/user/Github/MRTG-TelkomCare-Report-Automation/.venv312/Scripts/python.exe
# Example Debian: /home/user/Github/MRTG-TelkomCare-Report-Automation/.venv312/bin/python
PADDLEOCR_PYTHON=

# Gemini Vision fallback, used only when PaddleOCR yields no usable text.
# Comma-separated models are tried in order until one returns text.
# GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
# GEMINI_MODELS=gemini-1.5-flash,gemini-2.0-flash

# ---------------------------------------------------------------------------
# [5] SOURCE 2: MRTG & TELKOMCARE (NETCARE)
# ---------------------------------------------------------------------------
MRTG_ENABLED=true
TELKOMCARE_BASE_URL=https://telkomcare.example.internal/public/login
TELKOMCARE_USERNAME=CHANGE_ME_USER
TELKOMCARE_PASSWORD=CHANGE_ME_PASS

# 2FA Authenticator TOTP Secret for TelkomCare
TOTP_SECRET=CHANGE_ME_BASE32_TOTP_SECRET

# Google Gemini API Key for MRTG Graph OCR
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODELS=gemini-1.5-flash,gemini-2.0-flash

# Pre-downloaded MRTG data directory (from MRTG-TelkomCare-Report-Automation):
# Example Debian: /home/user/Github-PC/MRTG-TelkomCare-Report-Automation/output/data/MRTG-Data
# Example Windows: C:/Users/user/Github-PC/MRTG-TelkomCare-Report-Automation/output/data/MRTG-Data
MRTG_TELKOMCARE_DIR=output/raw/mrtg
MRTG_CMP_DIR=output/raw/mrtg_secondary

# Direct MikroTik RouterOS API & Native Indibiz Traffic Sampler:
ROUTEROS_HOST=id-04.tunnel.web.id
ROUTEROS_PORT=5336
ROUTEROS_USERNAME=CHANGE_ME_ROUTER_USER
ROUTEROS_PASSWORD=CHANGE_ME_ROUTER_PASS
ROUTEROS_INTERFACE=WAN
ROUTEROS_TIMEOUT_SECONDS=30
ROUTEROS_PLAINTEXT_LOGIN=true
INDIBIZ_DB_PATH=output/raw/indibiz/traffic.db

# ---------------------------------------------------------------------------
# [6] SOURCE 3: PRTG SENSOR MONITORING
# ---------------------------------------------------------------------------
PRTG_ENABLED=true
PRTG_BASE_URL=http://10.10.1.10
PRTG_USERNAME=CHANGE_ME_PRTG_ADMIN
PRTG_PASSWORD=CHANGE_ME_PRTG_PASS
PRTG_TIMEOUT_SECONDS=15

# ---------------------------------------------------------------------------
# [7] SOURCE 4: SWITCH & ARUBA AIRWAVE NMS
# ---------------------------------------------------------------------------
AIRWAVE_ENABLED=true
AIRWAVE_BASE_URL=https://10.10.1.20
AIRWAVE_USERNAME=CHANGE_ME_AIRWAVE_USER
AIRWAVE_PASSWORD=CHANGE_ME_AIRWAVE_PASS
AIRWAVE_HEADLESS=true
AIRWAVE_REPORT_TITLE=Uptime ALL device switch
AIRWAVE_POLL_INTERVAL_SECONDS=15
AIRWAVE_POLL_TIMEOUT_MINUTES=10

# Pre-downloaded AirWave export directory (from Switch-Report-Auto):
# Example Debian: /home/user/Github-PC/Switch-Report-Auto/output
# Example Windows: C:/Users/user/Github-PC/Switch-Report-Auto/output
AIRWAVE_EXPORT_DIR=output/raw/airwave

# ---------------------------------------------------------------------------
# [8] SOURCE 5: HUAWEI ACCESS POINT CONTROLLER (iMaster NCE)
# ---------------------------------------------------------------------------
HUAWEI_ENABLED=true
HUAWEI_BASE_URL=https://10.10.1.30
HUAWEI_LOGIN_PATH=/view/login.html
HUAWEI_USERNAME=CHANGE_ME_HUAWEI_USER
HUAWEI_PASSWORD=CHANGE_ME_HUAWEI_PASS
HUAWEI_HEADLESS=true
HUAWEI_LOGIN_TIMEOUT_SECONDS=45
HUAWEI_EXPORT_TIMEOUT_SECONDS=180
HUAWEI_NAV_TIMEOUT_SECONDS=60

# Portal CSS Selectors (Do not change unless portal DOM changes)
HUAWEI_SEL_LOGIN_USERNAME=#username
HUAWEI_SEL_LOGIN_PASSWORD=#password
HUAWEI_SEL_LOGIN_SUBMIT=#submitButton
HUAWEI_SEL_NAV_AP=#dashAP
HUAWEI_SEL_EXPORT_AP=#outputApListInfoBtnEn
HUAWEI_SEL_NAV_SSID=#dashSSIDs
HUAWEI_SEL_EXPORT_SSID=#ssidListExportBtn

# Pre-downloaded Huawei CSV files (from AP-Report-Auto):
# Example Debian: /home/user/Github-PC/AP-Report-Auto/output/raw
# Example Windows: C:/Users/user/Github-PC/AP-Report-Auto/output/raw
HUAWEI_RAW_DIR=output/raw/huawei_ap

# ---------------------------------------------------------------------------
# [9] SOURCE 6: MODEM ORBIT (Native Playwright Scraper + Cache Fallback)
# ---------------------------------------------------------------------------
ORBIT_ENABLED=true
ORBIT_HEADLESS=true
ORBIT_TIMEOUT_SECONDS=60
# Example Debian: /home/user/Github-PC/MRTG-CMP/data/orbit_cache/modems.json
# Example Windows: C:/Users/user/Github-PC/MRTG-CMP/data/orbit_cache/modems.json
ORBIT_CACHE_FILE=output/raw/orbit/modems.json

# ---------------------------------------------------------------------------
# [10] SOURCE 7: NEXTHOP PING (LOCAL ICMP PING)
# ---------------------------------------------------------------------------
PING_COUNT=5
PING_TIMEOUT_SECONDS=2
